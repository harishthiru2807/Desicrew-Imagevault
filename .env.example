# Firebase Web App Client Configuration
# Obtain these from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend OTP Service URL (Firebase Cloud Function or custom backend)
# Example for deployed Cloud Function:
# https://us-central1-your_project_id.cloudfunctions.net/api
# In development, leave blank or point to local emulator / dev endpoint
VITE_OTP_API_URL=
