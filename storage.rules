rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: is owner of this path?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: validate uploaded image file
    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 15 * 1024 * 1024; // Max 15MB
    }

    // ─── User Profile Photo ─────────────────────────────────────────
    // users/{userId}/avatar/{fileName}
    match /users/{userId}/avatar/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }

    // ─── User Record Images ─────────────────────────────────────────
    // users/{userId}/records/{recordId}/{fileName}
    match /users/{userId}/records/{recordId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }
  }
}
